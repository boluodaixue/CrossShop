# ===== Server =====
PORT=8000
LOG_LEVEL=info
DATA_DIR=./data

# ===== LLM (OpenAI 兼容协议) =====
# 敏感项（LLM_BASE_URL / LLM_API_KEY）推荐通过环境变量注入：
#   export LLM_BASE_URL=<网关地址> LLM_API_KEY=<密钥>
# 环境变量优先于本文件；本文件仅作为本地开发兜底，已被 gitignore，勿提交真实密钥
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=qwen3-max

# ===== Embedding (OpenAI 兼容 /v1/embeddings，缺省复用 LLM_* 网关) =====
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4

# ===== H5 长期偏好选择 =====
# like 使用独立逻辑客户端按本轮明确需求选相关 Top-K；默认物理复用 PRODUCT BGE 服务，
# 但不会进入 ProductSearchSpec、商品 Query、OpenSearch 或 Reranker。
# 关闭或相关性服务失败时只保留全量 dislike，不回退为“最新 like Top-K”。
PREFERENCE_RELEVANCE_ENABLED=1
PREFERENCE_TOP_K=5
# PREFERENCE_EMBEDDING_BASE_URL=http://127.0.0.1:8002/v1
# PREFERENCE_EMBEDDING_API_KEY=
PREFERENCE_EMBEDDING_MODEL=BAAI/bge-m3
PREFERENCE_EMBEDDING_DIM=1024

# ===== 商品 Query Tower（OpenAI 兼容 /v1/embeddings） =====
# 必须与离线 Item Tower 使用同一个 BGE-M3 向量空间；与上面的品类 RAG/语义缓存配置分离。
# 本地服务或外部兼容 endpoint 均可，服务需返回 1024 维向量。
PRODUCT_EMBEDDING_BASE_URL=http://127.0.0.1:8002/v1
# PRODUCT_EMBEDDING_API_KEY=
PRODUCT_EMBEDDING_MODEL=BAAI/bge-m3
PRODUCT_EMBEDDING_DIM=1024

# ===== H4 商品 OpenSearch（离线索引，在线只读） =====
PRODUCT_CATALOG_ROOT=./data/processed/catalogs-v2
OPENSEARCH_ENDPOINT=http://127.0.0.1:9200
OPENSEARCH_TIMEOUT_SECONDS=30

# ===== 向量库 Qdrant（空 = qdrant-client 本地嵌入模式，落盘 DATA_DIR/qdrant） =====
# QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=globex_products
# 品类洞察 RAG 使用独立版本 collection；切换 release 时必须同步升级名称。
CATEGORY_KB_COLLECTION=globex_category_kb_v1

# ===== Reranker（空 = 降级为按向量分排序，rerank_applied=false） =====
# 本地验收服务：C:\Anaconda\envs\blog_04\python.exe -m scripts.rerank.serve_bge_reranker
# RERANKER_BASE_URL=http://127.0.0.1:8001
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ===== Web 搜索 Tavily（空 = 不注册 web_search_tool） =====
# TAVILY_API_KEY=tvly-xxx

# ===== LangFuse / OpenTelemetry 可观测（默认关闭） =====
# AgentScope TracingMiddleware 始终装配；以下均不配置时不初始化 exporter、不会发网络。
# LangFuse 启用时自动通过 OTLP/HTTP v4 实时 ingestion 路径导出。
LANGFUSE_ENABLED=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1
# 默认不导出 Agent/模型输入输出与工具参数/结果；显式开启也只导出摘要指纹与结构。
LANGFUSE_CAPTURE_INPUT=0
LANGFUSE_CAPTURE_OUTPUT=0
LANGFUSE_FLUSH_TIMEOUT_SECONDS=20
# 通用 OTLP 后端可只配置此项；LangFuse 开启时也可用它覆盖默认 OTLP 地址。
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
