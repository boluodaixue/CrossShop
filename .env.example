# OpenAI-compatible model configuration. Never put real keys in this template.
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_MAIN=
LLM_JUDGE=

# Stage 6 local CategoryInsight RAG. The checked-in default index name is safe.
GLOBEX_OPENSEARCH_ENDPOINT=http://127.0.0.1:9200
GLOBEX_CATEGORY_INDEX=globex_category_kb
GLOBEX_CATEGORY_TAXONOMY=data/category_insight/category_taxonomy.json
GLOBEX_MODELS_LOCAL_ONLY=true
GLOBEX_CATEGORY_RERANKER_ENABLED=false
GLOBEX_CATEGORY_RERANKER_PYTHON=
GLOBEX_CATEGORY_RERANKER_DEVICE=cuda:0
GLOBEX_CATEGORY_RERANKER_BATCH_SIZE=1
GLOBEX_CATEGORY_RERANKER_FP32=false
GLOBEX_CATEGORY_RERANKER_DOCUMENT_MODE=contextual
