LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_FALLBACK_MODEL=qwen3.7-plus
# Deprecated compatibility field; new code does not depend on it.
LLM_JUDGE=deepseek-v4-flash
# Independent small online whole-answer Evidence Judge; never inherited from LLM_MODEL.
ONLINE_EVIDENCE_JUDGE_MODEL=deepseek-v4-flash
# Offline Rubric Generator and Final Judge are separate roles, same first model.
EVAL_RUBRIC_GENERATOR_MODEL=deepseek-v4-flash
EVAL_FINAL_JUDGE_MODEL=deepseek-v4-flash
EVAL_PASS_THRESHOLD=0.85
DATABASE_URL=file
REDIS_URL=
# LangGraph checkpoint client; falls back to REDIS_URL when blank.
CHECKPOINT_REDIS_URL=
GLOBEX_ENV=local
# Seven days, in minutes. Reads refresh the TTL by default.
CHECKPOINT_TTL_MINUTES=10080
CHECKPOINT_REFRESH_ON_READ=1
# Local development may run without encryption. Non-local startup requires a key,
# but langgraph-checkpoint-redis 0.5.2 currently rejects configured keys because
# AsyncRedisSaver has no public serializer injection; do not claim at-rest encryption.
CHECKPOINT_REQUIRE_ENCRYPTION=0
LANGGRAPH_AES_KEY=
# HMAC secret for anonymous, stable thread identities. Set a real secret outside tests.
THREAD_ID_HMAC_KEY=
QUEUE_ENABLED=0
SEMANTIC_CACHE_ENABLED=1
ORDER_CONFIRMATION_TTL_SECONDS=300
# Phase-D token budgeting is observe-only until the configured qwen3-max
# gateway exposes its real message tokenizer/usage. Zero values are therefore
# deliberately unset thresholds, not measured production recommendations.
CONTEXT_SIZE=128000
TOOL_RESULT_LIMIT=20000
REPLY_TOKEN_BUDGET=0
CONTEXT_SAFETY_MARGIN_TOKENS=0
CONTEXT_SOFT_LIMIT_TOKENS=0
CONTEXT_BUDGET_MODE=observe_only
# Lifecycle fidelity window: keep the newest frozen interaction outside L3.
# Set explicitly to 0 only after evaluating that behavior; this is not a token threshold.
L3_KEEP_RECENT_FROZEN_SEGMENTS=1
# Local 4GB profile: resident CPU FP32 query worker. Production can set
# BGE_M3_DEVICE=cuda:0 and point BGE_M3_PYTHON at the CUDA environment.
BGE_M3_DEVICE=cpu
BGE_M3_PYTHON=.venv/Scripts/python.exe
BGE_M3_BATCH_SIZE=4
BGE_M3_MAX_SEQ_LENGTH=512
# Persistent GPU FP16 reranker profile for a 4GB GPU host. Benchmark 4/8/16
# once on the target machine and keep the fastest non-OOM value.
# Set this to the CUDA Python executable on the target host; blank uses the
# current environment and keeps this template portable.
BGE_RERANKER_PYTHON=
BGE_RERANKER_DEVICE=cuda:0
BGE_RERANKER_BATCH_SIZE=16
BGE_RERANKER_MAX_LENGTH=256
BGE_RERANKER_FP32=0
